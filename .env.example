# Copy this file to .env.local and fill in the values.
# Only the three Supabase variables gate core functionality; the rest degrade
# gracefully. See README → "Environment" for details.

# --- Supabase (Auth + content/media storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Used for absolute URLs in SEO metadata and outbound email.
NEXT_PUBLIC_SITE_URL=https://www.whitesands.org.ng

# --- ImageKit (image CDN) ---
# Falls back to the default endpoint in src/lib/imagekit.ts when unset.
NEXT_PUBLIC_IMAGEKIT_URL=

# --- Resend (transactional email) ---
# Without this, form submissions are still saved to the admin inbox; only the
# email notification/confirmation is skipped.
RESEND_API_KEY=

# Contact form recipients (optional — default to SITE.email / a noreply sender)
CONTACT_MESSAGE_TO=
CONTACT_MESSAGE_FROM=

# Visit-request recipients (optional — same defaults)
VISIT_INQUIRY_TO=
VISIT_INQUIRY_FROM=
